#: helpdesk/forms.py:535
msgid "Your E-Mail Address"
msgstr "O Seu Endereço de E-Mail"

#: helpdesk/forms.py:536
msgid "We will e-mail you when your ticket is updated."
msgstr "Enviaremos um e-mail quando o seu ticket for atualizado."

#: helpdesk/forms.py:607
msgid "Ticket Opened Via Web"
msgstr "Ticket Aberto Via Web"

#: helpdesk/forms.py:717
