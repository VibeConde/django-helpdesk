#: helpdesk/templates/helpdesk/ticket_merge.html:5
#: helpdesk/templates/helpdesk/ticket_merge.html:16
#: helpdesk/templates/helpdesk/ticket_merge.html:24
#| msgid "Open Tickets"
msgid "Merge Tickets"
msgstr "Fundir Tickets"

#: helpdesk/templates/helpdesk/ticket_merge.html:34
msgid "OK"
msgstr "OK"

#: helpdesk/templates/helpdesk/ticket_merge.html:43
msgid ""
"\n"
"                        Choose the ticket which will be conserved and then, "
"for each information, you can decide to use\n"
"                        a data from another ticket to merge. I you don't "
"select a data on a row, <b>the information\n"
"                        from the main ticket will stay unchanged</b>.\n"
"                    "
msgstr "\n                        Escolha o ticket que será mantido e, para cada informação, pode optar por utilizar\n                        os dados de outro ticket a fundir. Se não selecionar dados numa linha, <b>a informação\n                        do ticket principal permanecerá inalterada</b>.\n                    "

#: helpdesk/templates/helpdesk/ticket_merge.html:50
msgid ""
"\n"
"                        The  <b>follow-ups</b> and <b>attachments</b> from "
"the merged tickets will be moved to\n"
"                        the main ticket.<br>\n"
"                        <b>Involved users</b> (the ticket submitter and "
"emails in CC) will also be added in the\n"
"                        main ticket CC list.<br>\n"
"                        However, ticket dependencies from the merged ticket "
"won't be applied to the main ticket.\n"
"                    "
msgstr "\n                        Os <b>comentários</b> e <b>anexos</b> dos tickets fundidos serão movidos para\n                        o ticket principal.<br>\n                        Os <b>utilizadores envolvidos</b> (o submissor do ticket e os e-mails em CC) também serão adicionados à\n                        lista de CC do ticket principal.<br>\n                        No entanto, as dependências do ticket fundido não serão aplicadas ao ticket principal.\n                    "

